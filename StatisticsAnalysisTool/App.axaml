<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StatisticsAnalysisTool.App"
             xmlns:local="using:StatisticsAnalysisTool"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="CinzelFont">avares://AlbionOnlineCompanion/Assets/Fonts/Cinzel.ttf#Cinzel</FontFamily>
        <FontFamily x:Key="EBGaramondFont">avares://AlbionOnlineCompanion/Assets/Fonts/#EB Garamond</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <!-- Custom font styles -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource CinzelFont}"/>
        </Style>
        <Style Selector="TextBlock.ui">
            <Setter Property="FontFamily" Value="{StaticResource EBGaramondFont}"/>
        </Style>

        <!-- Dynamic theme-aware styles -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource ThemeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <!-- EB Garamond as the app-wide default; Cinzel overrides on .header/.title -->
            <Setter Property="FontFamily" Value="{StaticResource EBGaramondFont}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHover}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForeground}" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="{DynamicResource ThemeBackground}" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
        </Style>

        <!-- Semantic text colors -->
        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
        </Style>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ThemeError}" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundDim}" />
        </Style>
    </Application.Styles>
</Application>
