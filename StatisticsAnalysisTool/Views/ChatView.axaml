<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
             x:Class="StatisticsAnalysisTool.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="💬 Chat" FontSize="24" FontWeight="Bold"/>
            <Button Content="Clear" Command="{Binding ClearMessagesCommand}" Padding="12,6"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Classes="dim"/>
        </StackPanel>

        <!-- Controls Row -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Channel:" VerticalAlignment="Center" Classes="dim"/>
                <ComboBox ItemsSource="{Binding ChannelFilters}"
                          SelectedItem="{Binding SelectedChannelFilter}"
                          Width="130"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding MessageCount, StringFormat='Messages: {0}'}" Classes="dim"/>
            </StackPanel>

            <CheckBox Grid.Column="3" Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- Chat Messages -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceAlt}" CornerRadius="8" Padding="8">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding FilteredMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="4"
                                    Padding="10" Margin="0,2">
                                <Grid ColumnDefinitions="70,80,120,*">
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding TimestampDisplay}"
                                               Classes="dim" FontSize="11" VerticalAlignment="Top"/>

                                    <!-- Channel Badge -->
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{Binding ChannelColor}">
                                        <TextBlock Text="{Binding ChannelName}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource ThemeBackground}"/>
                                    </Border>

                                    <!-- Sender -->
                                    <TextBlock Grid.Column="2" Text="{Binding SenderName}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource ThemeAccent}"
                                               VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>

                                    <!-- Message -->
                                    <TextBlock Grid.Column="3" Text="{Binding OriginalText}"
                                               TextWrapping="Wrap" FontSize="13"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
