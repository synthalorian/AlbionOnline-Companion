<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StatisticsAnalysisTool.Views.CraftingCalculatorView"
             x:DataType="vm:CraftingCalculatorViewModel">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*">
        <!-- Left Panel - Item Selection -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Margin="12">
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="Search items..."
                             Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding Cities}"
                              SelectedItem="{Binding SelectedCity}"
                              PlaceholderText="Select city"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ThemeBackground}" CornerRadius="4" Padding="12" Margin="12,0,12,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeForeground}" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Tier}" Foreground="{DynamicResource ThemeForegroundDim}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Panel - Calculator -->
        <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}" Padding="16" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" 
                               Text="{Binding SelectedItem.Name, FallbackValue='Select an item'}" 
                               Foreground="{DynamicResource ThemeForeground}" 
                               FontSize="20" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Calculate"
                            Command="{Binding CalculateProfitCommand}"
                            Background="{DynamicResource ThemeSuccess}"
                            Foreground="{DynamicResource ThemeBackground}"
                            FontWeight="Bold"
                            Padding="20,10"
                            IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </Border>

            <!-- Calculator Content -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="16" Spacing="16">

                    <!-- Crafting Options -->
                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CRAFTING OPTIONS" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="14" FontWeight="Bold"/>
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Quantity:" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4"/>
                                    <NumericUpDown Value="{Binding CraftQuantity}" Minimum="1" Maximum="999" Width="120"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="City:" Foreground="{DynamicResource ThemeForeground}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" Width="150"/>
                                </StackPanel>
                                <CheckBox Grid.Row="1" Grid.Column="0" 
                                          Content="Use Focus" 
                                          IsChecked="{Binding UseFocus}"
                                          Foreground="{DynamicResource ThemeForeground}"
                                          Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Resources -->
                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="REQUIRED RESOURCES" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="14" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding RequiredResources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource ThemeForeground}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="{DynamicResource ThemeForeground}" Margin="16,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPrice}" Foreground="{DynamicResource ThemeForegroundDim}" Margin="16,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalPrice}" Foreground="{DynamicResource ThemeWarning}" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Cost Summary -->
                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="COST SUMMARY" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="14" FontWeight="Bold"/>
                            
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Resource Cost:" Foreground="{DynamicResource ThemeForeground}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalResourceCost}" Foreground="{DynamicResource ThemeForeground}" HorizontalAlignment="Right"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Crafting Fee:" Foreground="{DynamicResource ThemeForeground}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalCraftingFee}" Foreground="{DynamicResource ThemeForeground}" HorizontalAlignment="Right"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Cost:" Foreground="{DynamicResource ThemeForeground}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalCost}" Foreground="{DynamicResource ThemeForeground}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Resource Return:" Foreground="{DynamicResource ThemeSuccess}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResourceReturnRate}" Foreground="{DynamicResource ThemeSuccess}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Profit -->
                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="PROFIT ESTIMATE" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="14" FontWeight="Bold"/>
                            
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Estimated Sell Price:" Foreground="{DynamicResource ThemeForeground}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EstimatedSellPrice}" Foreground="{DynamicResource ThemeForeground}" HorizontalAlignment="Right"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Profit:" Foreground="{DynamicResource ThemeSuccess}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Profit}" Foreground="{DynamicResource ThemeSuccess}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Profit Margin:" Foreground="{DynamicResource ThemeSuccess}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfitMargin}" Foreground="{DynamicResource ThemeSuccess}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
