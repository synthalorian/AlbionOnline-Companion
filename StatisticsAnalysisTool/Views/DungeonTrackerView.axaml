<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StatisticsAnalysisTool.Views.DungeonTrackerView"
             x:DataType="vm:DungeonTrackerViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header Controls -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}" Padding="12" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox ItemsSource="{Binding StatTimeTypes}"
                          SelectedItem="{Binding SelectedStatTimeType}"
                          Width="150"/>
                <ComboBox ItemsSource="{Binding DungeonStatsTypes}"
                          SelectedItem="{Binding SelectedDungeonStatsType}"
                          Width="150"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300">
            <!-- Dungeon List -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBackground}" CornerRadius="4" Margin="0,0,8,0">
                <Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Dungeons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeForeground}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Tier}" Foreground="{DynamicResource ThemeForegroundDim}" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Fame, StringFormat='{}{0} Fame'}" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="12" Margin="12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Silver, StringFormat='{}{0} Silver'}" Foreground="{DynamicResource ThemeWarning}" FontSize="12" Margin="12,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Duration, StringFormat='hh\\:mm'}" Foreground="{DynamicResource ThemeForegroundDim}" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <TextBlock IsVisible="{Binding Dungeons.Count, Converter={x:Static ObjectConverters.IsNull}}"
                               Text="No dungeons tracked yet"
                               Foreground="{DynamicResource ThemeForegroundDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="32"/>
                </Grid>
            </Border>

            <!-- Stats Sidebar -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="STATISTICS" Foreground="{DynamicResource ThemeAccentSecondary}" FontSize="14" FontWeight="Bold"/>
                    
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Total Dungeons:" Foreground="{DynamicResource ThemeForeground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalDungeons}" Foreground="{DynamicResource ThemeForeground}" FontWeight="Bold"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Total Fame:" Foreground="{DynamicResource ThemeForeground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalFame}" Foreground="{DynamicResource ThemeAccentSecondary}" FontWeight="Bold"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Total Silver:" Foreground="{DynamicResource ThemeForeground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalSilver}" Foreground="{DynamicResource ThemeWarning}" FontWeight="Bold"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Avg Fame/Dungeon:" Foreground="{DynamicResource ThemeForeground}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AverageFamePerDungeon, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource ThemeForeground}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <Border Background="{DynamicResource ThemeBorder}" CornerRadius="4" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CLOSE TIMER" Foreground="{DynamicResource ThemeError}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DungeonCloseTimer}" Foreground="{DynamicResource ThemeForeground}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Controls -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface}" Padding="12" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Delete Selected"
                        Command="{Binding DeleteSelectedDungeonsCommand}"
                        Background="{DynamicResource ThemeError}"
                        Foreground="{DynamicResource ThemeBackground}"
                        Padding="16,8"/>
                <Button Content="Delete Zero Fame"
                        Command="{Binding DeleteZeroFameDungeonsCommand}"
                        Background="{DynamicResource ThemeError}"
                        Foreground="{DynamicResource ThemeBackground}"
                        Padding="16,8"/>
                <Button Content="Reset All"
                        Command="{Binding ResetDungeonTrackingCommand}"
                        Background="{DynamicResource ThemeError}"
                        Foreground="{DynamicResource ThemeBackground}"
                        Padding="16,8"/>
                <Button Content="Reset Today"
                        Command="{Binding ResetTodaysDungeonsCommand}"
                        Background="{DynamicResource ThemeError}"
                        Foreground="{DynamicResource ThemeBackground}"
                        Padding="16,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
