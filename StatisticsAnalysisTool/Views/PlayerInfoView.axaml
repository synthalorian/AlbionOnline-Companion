<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="StatisticsAnalysisTool.Views.PlayerInfoView"
             x:DataType="vm:PlayerInfoViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Search Header -->
        <Border Grid.Row="0" Background="#FF313244" Padding="16" BorderBrush="#FF45475A" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchText}"
                         PlaceholderText="Enter player name..."
                         FontSize="16"
                         Padding="12,8"/>
                <Button Grid.Column="1"
                        Content="Search"
                        Command="{Binding SearchPlayerCommand}"
                        Background="#FF89B4FA"
                        Foreground="#FF1E1E2E"
                        FontWeight="Bold"
                        Padding="20,10"
                        Margin="12,0,0,0"/>
                <Button Grid.Column="2"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        Padding="20,10"
                        Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="1" Background="#FF1E1E2E" Padding="8" IsVisible="{Binding !IsPlayerFound}">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="#FF6C7086" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Player Info -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsPlayerFound}">
            <StackPanel Margin="16" Spacing="16">

                <!-- Player Header -->
                <Border Background="#FF313244" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding PlayerName}" 
                                   Foreground="#FFCDD6F4" 
                                   FontSize="28" 
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel>
                                <TextBlock Text="GUILD" Foreground="#FF6C7086" FontSize="11"/>
                                <TextBlock Text="{Binding GuildName}" Foreground="#FF89B4FA" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ALLIANCE" Foreground="#FF6C7086" FontSize="11"/>
                                <TextBlock Text="{Binding AllianceName}" Foreground="#FFF5C2E7" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fame Stats -->
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0" Grid.Column="0" Background="#FF313244" CornerRadius="8" Padding="16" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="KILL FAME" Foreground="#FFF38BA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding KillFame}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#FF313244" CornerRadius="8" Padding="16" Margin="4,0,4,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="DEATH FAME" Foreground="#FFF38BA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DeathFame}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#FF313244" CornerRadius="8" Padding="16" Margin="8,0,0,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="K/D RATIO" Foreground="#FFF38BA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FameRatio}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="#FF313244" CornerRadius="8" Padding="16" Margin="0,8,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="GATHERING FAME" Foreground="#FFA6E3A1" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GatheringFame}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="#FF313244" CornerRadius="8" Padding="16" Margin="4,8,4,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CRAFTING FAME" Foreground="#FFF9E2AF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CraftingFame}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="#FF313244" CornerRadius="8" Padding="16" Margin="8,8,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="TOTAL FAME" Foreground="#FF89B4FA" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalFame}" Foreground="#FFCDD6F4" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Equipment -->
                <Border Background="#FF313244" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="EQUIPMENT" Foreground="#FF89B4FA" FontSize="14" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Equipment}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E1E2E" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Slot}" Foreground="#FF6C7086" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemName}" Foreground="#FFCDD6F4" FontSize="14" Margin="12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tier}" Foreground="#FF89B4FA" FontSize="12" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
