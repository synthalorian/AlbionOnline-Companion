<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
        xmlns:views="using:StatisticsAnalysisTool.Views"
        xmlns:common="using:StatisticsAnalysisTool.Common"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="StatisticsAnalysisTool.Views.MainWindow"
        x:DataType="vm:MainViewModel"
       
        Title="{Binding Title}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource ThemeBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DamageMeterViewModel}">
            <views:DamageMeterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DungeonTrackerViewModel}">
            <views:DungeonTrackerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LootLoggerViewModel}">
            <views:LootLoggerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CraftingCalculatorViewModel}">
            <views:CraftingCalculatorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerInfoViewModel}">
            <views:PlayerInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GatheringViewModel}">
            <views:GatheringView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MapHistoryViewModel}">
            <views:MapHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KillFeedViewModel}">
            <views:KillFeedView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <common:BoolToTrackingTextConverter x:Key="TrackingTextConverter"/>
        <common:BoolToTrackingColorConverter x:Key="TrackingColorConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="250,*">

        <!-- Header Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{DynamicResource ThemeSurfaceAlt}"
                BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="⚔️" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding IsTracking, Converter={StaticResource TrackingTextConverter}}"
                        Command="{Binding ToggleTrackingCommand}"
                        Background="{Binding IsTracking, Converter={StaticResource TrackingColorConverter}}"
                        Foreground="{DynamicResource ThemeBackground}"
                        FontWeight="Bold"
                        Padding="20,8"
                        Margin="0,0,12,0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundDim}"/>
            </Grid>
        </Border>

        <!-- Sidebar Navigation -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource ThemeSurfaceAlt}"
                BorderBrush="{DynamicResource ThemeBorder}"
                BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Padding="12,8"
                                   FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ThemeButtonHover}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource ThemeBackground}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- Privilege Escalation Dialog Overlay -->
        <Panel IsVisible="{Binding ShowPrivilegeDialog}" 
               Background="#80000000"
               Grid.RowSpan="2" Grid.ColumnSpan="2"
               ZIndex="100">
            <Border Background="{DynamicResource ThemeSurface}" 
                    CornerRadius="12" 
                    Padding="24"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource ThemeAccent}"
                    BorderThickness="2">
                <StackPanel Spacing="16">
                    <TextBlock Text="🔐 Elevated Privileges Required" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeAccent}"/>
                    
                    <TextBlock Text="Packet capture requires root/admin privileges to read network traffic from Albion Online."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeForeground}"/>
                    
                    <TextBlock Text="{Binding PrivilegeStatusText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeWarning}"/>
                    
                    <Border Background="{DynamicResource ThemeSurfaceAlt}" 
                            CornerRadius="4" 
                            Padding="12">
                        <TextBlock Text="{Binding PrivilegeInstructions}"
                                   TextWrapping="Wrap"
                                   FontFamily="monospace"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThemeForegroundDim}"/>
                    </Border>
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" 
                                Content="🔑 Authenticate (pkexec)"
                                Command="{Binding RestartWithPkexecCommand}"
                                Background="{DynamicResource ThemeSuccess}"
                                Foreground="{DynamicResource ThemeBackground}"
                                FontWeight="Bold"
                                Padding="12,8"
                                Margin="0,0,4,0"/>
                        <Button Grid.Column="1" 
                                Content="📋 Copy Command"
                                Padding="12,8"
                                Margin="4,0"/>
                        <Button Grid.Column="2" 
                                Content="✕ Dismiss"
                                Command="{Binding DismissPrivilegeDialogCommand}"
                                Padding="12,8"
                                Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
