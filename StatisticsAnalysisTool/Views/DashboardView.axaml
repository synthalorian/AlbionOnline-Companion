<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatisticsAnalysisTool.ViewModels"
             x:Class="StatisticsAnalysisTool.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">

            <!-- Player Info Bar -->
            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="⚔️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="{Binding GuildName}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="ZONE" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding CurrentZone}" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="SESSION" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding SessionDuration}" FontSize="14" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeInfo}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="Reset" Command="{Binding ResetTrackingCounterCommand}"
                            Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Total Stats Row -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL FAME" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding TotalFame}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccent}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL SILVER" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding TotalSilver}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeWarning}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL RESPEC" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding TotalReSpecPoints}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccentSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Session Fame Section -->
            <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="📈 SESSION FAME" FontSize="14" FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeAccent}"/>
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gained" FontSize="11" Classes="dim"/>
                            <TextBlock Text="{Binding SessionFame}" FontSize="24" FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeAccent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Per Hour" FontSize="11" Classes="dim"/>
                            <TextBlock Text="{Binding FamePerHour}" FontSize="24" FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeSuccess}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Silver/hr" FontSize="11" Classes="dim"/>
                            <TextBlock Text="{Binding SilverPerHour}" FontSize="24" FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeWarning}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Fame Breakdown -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="⚔️ COMBAT FAME" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeError}"/>
                        <TextBlock Text="{Binding CombatFame}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CombatFamePerHour}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="⛏️ GATHERING FAME" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeSuccess}"/>
                        <TextBlock Text="{Binding GatheringFame}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GatheringFamePerHour}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="🔨 CRAFTING FAME" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeOrange}"/>
                        <TextBlock Text="{Binding CraftingFame}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CraftingFamePerHour}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🌾 FARMING FAME" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeWarning}"/>
                        <TextBlock Text="{Binding FarmingFame}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding FarmingFamePerHour}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Secondary Stats -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="SILVER" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding SessionSilver}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeWarning}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="RESPEC" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding SessionReSpec}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeAccentSecondary}"/>
                        <TextBlock Text="{Binding ReSpecPerHour}" FontSize="11" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="MIGHT" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding SessionMight}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeSuccess}"/>
                        <TextBlock Text="{Binding MightPerHour}" FontSize="11" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="FAVOR" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding SessionFavor}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeError}"/>
                        <TextBlock Text="{Binding FavorPerHour}" FontSize="11" Classes="dim"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- K/D + Chests -->
            <Grid ColumnDefinitions="*,*">
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="0,0,4,0"
                        IsVisible="{Binding KillDeathStatsVisible}">
                    <StackPanel>
                        <TextBlock Text="KILLS / DEATHS" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding KillsDeathsText}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding KdRatio, StringFormat='K/D: {0}'}" FontSize="12" Classes="dim"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="12" Margin="4,0,0,0"
                        IsVisible="{Binding LootedChestsStatsVisible}">
                    <StackPanel>
                        <TextBlock Text="LOOTED CHESTS" FontSize="10" Classes="dim"/>
                        <TextBlock Text="{Binding LootedChestsText}" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource ThemeInfo}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
